# Copy to .env and fill in. Never commit .env.

# Public domain pointing at this VM (own domain or e.g. myshop.duckdns.org). Caddy gets the TLS certificate.
DOMAIN=myshop.duckdns.org

# Anthropic API key (stays on the server only).
ANTHROPIC_API_KEY=sk-ant-...

# One token per device, comma-separated, each >= 24 chars. Generate: openssl rand -hex 24
# The position in this list is the device id used for usage counts (0 = first) — append new tokens at the end.
THRIFT_TOKENS=replace-with-openssl-rand-hex-24-for-computer,replace-with-openssl-rand-hex-24-for-iphone

# Remote kill switch: false makes the extensions stop filling.
AUTOFILL_ENABLED=true

# Optional overrides
# MODEL=claude-haiku-5-5
# FORM_MAP_PATH=/app/data/form-map.json
# PORT=8787
